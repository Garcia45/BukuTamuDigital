<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutGuestListRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas">

    <!-- Header & Search Chrome Stabil dengan Safe-Area Status Bar Inset -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bg_surface"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:subtitleTextAppearance="@style/TextAppearance.BukuTamu.Caption"
            app:subtitleTextColor="@color/text_secondary"
            app:title="@string/title_guest_list"
            app:titleTextAppearance="@style/TextAppearance.BukuTamu.Title"
            app:titleTextColor="@color/text_primary" />

        <!-- Kolom Pencarian Nama Tamu (FR-23) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginHorizontal="@dimen/page_horizontal_padding"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_search_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/etSearchGuest"
                style="@style/TextAppearance.BukuTamu.BodySecondary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/hint_search_guest"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary" />

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_clear_search"
                android:src="@drawable/ic_close_circle"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="@dimen/hairline_stroke"
        android:background="@color/surface_separator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainer" />

    <!-- Daftar Tamu: Tinggi item mengikuti jumlah data sebenarnya (tidak menarik kotak kosong ke bawah) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGuests"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/page_horizontal_padding"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/bottomListDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintWidth_max="@dimen/content_max_width" />

    <!-- Empty State & No Search Result State yang Terpusat Secara Proporsional (FR-17) -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/page_horizontal_padding"
        android:background="@drawable/bg_grouped_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_6"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomListDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_empty_guest" />

        <TextView
            android:id="@+id/tvEmptyStateTitle"
            style="@style/TextAppearance.BukuTamu.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:gravity="center"
            android:text="@string/empty_guest_list_title" />

        <TextView
            android:id="@+id/tvEmptyState"
            style="@style/TextAppearance.BukuTamu.BodySecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center"
            android:text="@string/empty_guest_list" />

    </LinearLayout>

    <!-- Bottom Docked Action Bar untuk Catat Tamu Baru -->
    <View
        android:id="@+id/bottomListDivider"
        android:layout_width="0dp"
        android:layout_height="@dimen/hairline_stroke"
        android:background="@color/surface_separator"
        app:layout_constraintBottom_toTopOf="@id/bottomListBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/bottomListBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_horizontal_padding"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fabAddGuest"
            style="@style/Widget.BukuTamu.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/content_max_width"
            android:text="@string/btn_add_guest"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/text_on_accent" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
