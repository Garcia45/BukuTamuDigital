<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas">

    <!-- Navigasi Atas yang Stabil -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_surface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/title_add_guest"
        app:titleTextAppearance="@style/TextAppearance.BukuTamu.Title"
        app:titleTextColor="@color/text_primary" />

    <View
        android:id="@+id/toolbarDivider"
        android:layout_width="0dp"
        android:layout_height="@dimen/hairline_stroke"
        android:background="@color/surface_separator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarDivider">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/page_horizontal_padding"
            android:paddingVertical="@dimen/page_vertical_padding">

            <LinearLayout
                android:id="@+id/containerFormContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/content_max_width">

                <TextView
                    android:id="@+id/tvFormSubtitle"
                    style="@style/TextAppearance.BukuTamu.BodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_4"
                    android:text="@string/subtitle_form_add" />

                <!-- Banner Waktu Kunjungan Read-Only saat Mode Edit (PRD 11.5 & FR-20) -->
                <LinearLayout
                    android:id="@+id/layoutVisitTimeBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_4"
                    android:background="@drawable/bg_banner_info"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_clock" />

                    <TextView
                        android:id="@+id/tvVisitTimeInfo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/accent_text"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Banner Error dengan Ikon + Teks -->
                <LinearLayout
                    android:id="@+id/layoutFormErrorBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_4"
                    android:background="@drawable/bg_banner_danger"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_info" />

                    <TextView
                        android:id="@+id/tvFormError"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:textColor="@color/semantic_danger"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    style="@style/TextAppearance.BukuTamu.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_2"
                    android:text="@string/section_guest_identity" />

                <!-- Panel Input Terkelompok (Grouped Form Surface) -->
                <LinearLayout
                    android:id="@+id/panelGuestForm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_grouped_panel"
                    android:orientation="vertical"
                    android:padding="@dimen/panel_inner_padding">

                    <!-- Persistent Associated Label: Nama Lengkap -->
                    <TextView
                        android:id="@+id/tvLabelNama"
                        style="@style/TextAppearance.BukuTamu.FieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/etNama"
                        android:text="@string/label_guest_name" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNama"
                        style="@style/Widget.BukuTamu.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:errorEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNama"
                            style="@style/TextAppearance.BukuTamu.BodyPrimary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/placeholder_guest_name"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLines="2"
                            android:minHeight="@dimen/touch_target_min"
                            android:textColorHint="@color/text_tertiary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Persistent Associated Label: Alamat / Instansi -->
                    <TextView
                        android:id="@+id/tvLabelAlamat"
                        style="@style/TextAppearance.BukuTamu.FieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:labelFor="@id/etAlamat"
                        android:text="@string/label_guest_address" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAlamat"
                        style="@style/Widget.BukuTamu.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:errorEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAlamat"
                            style="@style/TextAppearance.BukuTamu.BodyPrimary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:hint="@string/placeholder_guest_address"
                            android:imeOptions="actionNext"
                            android:inputType="textPostalAddress|textMultiLine|textCapSentences"
                            android:maxLines="4"
                            android:minLines="2"
                            android:textColorHint="@color/text_tertiary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Persistent Associated Label: Keperluan Kunjungan -->
                    <TextView
                        android:id="@+id/tvLabelKeperluan"
                        style="@style/TextAppearance.BukuTamu.FieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:labelFor="@id/etKeperluan"
                        android:text="@string/label_guest_purpose" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilKeperluan"
                        style="@style/Widget.BukuTamu.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:errorEnabled="true">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etKeperluan"
                            style="@style/TextAppearance.BukuTamu.BodyPrimary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:hint="@string/placeholder_guest_purpose"
                            android:imeOptions="actionDone"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLines="5"
                            android:minLines="3"
                            android:textColorHint="@color/text_tertiary" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- Hierarki Tombol Tindakan (Primary -> Secondary -> Quiet Destructive) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    style="@style/Widget.BukuTamu.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_5"
                    android:text="@string/btn_save" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancel"
                    style="@style/Widget.BukuTamu.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/btn_cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteInForm"
                    style="@style/Widget.BukuTamu.Button.DestructiveQuiet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_3"
                    android:text="@string/btn_delete"
                    android:visibility="gone"
                    app:icon="@drawable/ic_delete"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/semantic_danger" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

