<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_target_min"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/panel_inner_padding"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/tvRecapDate"
            style="@style/TextAppearance.BukuTamu.BodyPrimary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvRecapCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_badge"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/accent_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/dividerRecap"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline_stroke"
        android:layout_marginStart="@dimen/panel_inner_padding"
        android:background="@color/surface_separator" />

</LinearLayout>

